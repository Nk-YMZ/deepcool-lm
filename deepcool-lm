#!/usr/bin/env python3
"""Deepcool LM 系列 LCD 的 USB、IPC 和命令行入口。"""

import argparse
import json
import os
import socket
import sys
import threading
import time
from pathlib import Path

# 安装后共享模块位于与 bin 同前缀的 lib/deepcool-lm；仓库内运行时无需此路径。
MODULE_DIRECTORY = Path(__file__).resolve().parent.parent / "lib" / "deepcool-lm"
if MODULE_DIRECTORY.is_dir():
    sys.path.insert(0, str(MODULE_DIRECTORY))

import usb.core
import usb.util

from deepcool_lm_display import (
    FRAMEBUFFER_SIZE,
    THEME_LIGHT,
    THEME_NAMES,
    load_fonts,
    render_monitor_framebuffer,
    render_solid_image,
    rgb_to_framebuffer,
)
from deepcool_lm_system import SystemMonitor


VENDOR_ID = 0x3633
PRODUCT_ID = 0x0026
EP_OUT = 0x01
SOCKET_PATH = "/var/run/deepcool-lm.sock"
THEME_PATH = Path(os.environ.get("STATE_DIRECTORY", "/var/lib/deepcool-lm")) / "theme"

# 这些字节来自对 Windows 驱动协议的逆向，不属于普通界面配置。
FRAME_HEADER = bytes(
    [0xAA, 0x08, 0x00, 0x00, 0x01, 0x00, 0x58, 0x02, 0x00, 0x2C, 0x01, 0xBC, 0x11]
)
BRIGHTNESS_UP = bytes([0xAA, 0x04, 0x00, 0x06, 0x03, 0x61, 0x00, 0xD2, 0x46])
BRIGHTNESS_DOWN = bytes([0xAA, 0x04, 0x00, 0x06, 0x03, 0x1D, 0x00, 0xE6, 0x0B])
INIT_QUERY = bytes([0xAA, 0x01, 0x00, 0x09, 0x29, 0x91])


class DisplayState:
    def __init__(self, theme_path=THEME_PATH):
        self._mode = "monitor"
        self._framebuffer = None
        self._theme_path = Path(theme_path)
        self._theme = _load_theme(self._theme_path)
        self._lock = threading.Lock()

    def set_monitor(self):
        with self._lock:
            self._mode = "monitor"
            self._framebuffer = None

    def set_solid(self, framebuffer):
        with self._lock:
            self._mode = "solid"
            self._framebuffer = framebuffer

    def set_theme(self, theme):
        if theme not in THEME_NAMES:
            raise ValueError(f"未知主题: {theme}")
        with self._lock:
            _save_theme(self._theme_path, theme)
            self._theme = theme

    def get(self):
        with self._lock:
            return self._mode, self._framebuffer, self._theme


class IPCServer:
    def __init__(self, device, display_state):
        self.device = device
        self.display_state = display_state
        self.running = False
        self.server_socket = None

    def start(self):
        try:
            os.unlink(SOCKET_PATH)
        except FileNotFoundError:
            pass

        self.server_socket = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.server_socket.bind(SOCKET_PATH)
        os.chmod(SOCKET_PATH, 0o666)
        self.server_socket.listen(4)
        self.running = True
        threading.Thread(target=self._serve, daemon=True).start()

    def _serve(self):
        while self.running:
            try:
                connection, _ = self.server_socket.accept()
            except OSError:
                break
            connection.settimeout(5)
            self._handle(connection)

    def _handle(self, connection):
        try:
            raw_request = _receive_all(connection, 64 * 1024)
            request = json.loads(raw_request.decode("utf-8"))
            action = request.get("action")

            if action == "brightness_up":
                self.device.brightness_up()
            elif action == "brightness_down":
                self.device.brightness_down()
            elif action == "monitor":
                self.display_state.set_monitor()
            elif action == "solid":
                color = _validate_color(request.get("color"))
                framebuffer = rgb_to_framebuffer(render_solid_image(color))
                self.display_state.set_solid(framebuffer)
            elif action == "theme":
                self.display_state.set_theme(request.get("theme"))
            else:
                raise ValueError(f"未知操作: {action}")
            response = {"status": "ok"}
        except Exception as error:
            response = {"status": "error", "message": str(error)}

        try:
            connection.sendall(json.dumps(response).encode("utf-8"))
        except OSError:
            pass
        finally:
            connection.close()

    def stop(self):
        self.running = False
        if self.server_socket:
            self.server_socket.close()
        try:
            os.unlink(SOCKET_PATH)
        except FileNotFoundError:
            pass


class LMDisplay:
    def __init__(self):
        self.device = None
        self.interface = 0

    def connect(self):
        self.device = usb.core.find(idVendor=VENDOR_ID, idProduct=PRODUCT_ID)
        if self.device is None:
            return False

        if self.device.is_kernel_driver_active(self.interface):
            try:
                self.device.detach_kernel_driver(self.interface)
            except Exception:
                pass
        try:
            self.device.set_configuration()
            usb.util.claim_interface(self.device, self.interface)
        except Exception:
            self.disconnect()
            return False
        return True

    def write(self, data):
        try:
            written = self.device.write(EP_OUT, data, timeout=5000)
        except Exception as error:
            raise RuntimeError(f"USB 写入失败: {error}") from error
        if written != len(data):
            raise RuntimeError(f"USB 写入不完整: {written}/{len(data)} 字节")

    def send_frame(self, framebuffer):
        if len(framebuffer) != FRAMEBUFFER_SIZE:
            raise ValueError(
                f"帧缓冲区长度错误: {len(framebuffer)}，应为 {FRAMEBUFFER_SIZE}"
            )
        self.write(FRAME_HEADER)
        self.write(framebuffer)

    def brightness_up(self):
        self.write(BRIGHTNESS_UP)

    def brightness_down(self):
        self.write(BRIGHTNESS_DOWN)

    def initialize(self):
        self.write(INIT_QUERY)

    def disconnect(self):
        if not self.device:
            return
        try:
            usb.util.release_interface(self.device, self.interface)
            usb.util.dispose_resources(self.device)
        except Exception:
            pass
        finally:
            self.device = None


def send_ipc_command(command):
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
            client.settimeout(5)
            client.connect(SOCKET_PATH)
            client.sendall(json.dumps(command).encode("utf-8"))
            client.shutdown(socket.SHUT_WR)
            response = _receive_all(client, 64 * 1024)
    except (FileNotFoundError, ConnectionRefusedError):
        return None
    except OSError as error:
        return {"status": "error", "message": str(error)}

    try:
        return json.loads(response.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        return {"status": "error", "message": f"IPC 响应无效: {error}"}


def run_monitor(device, interval):
    device.initialize()
    time.sleep(0.5)

    display_state = DisplayState()
    ipc_server = IPCServer(device, display_state)
    ipc_server.start()
    monitor = SystemMonitor()
    fonts = load_fonts()
    frame_count = 0
    print(f"监控已启动，IPC socket: {SOCKET_PATH}")

    try:
        while True:
            mode, framebuffer, theme = display_state.get()
            if mode == "monitor":
                snapshot = monitor.sample()
                framebuffer = render_monitor_framebuffer(snapshot, fonts, theme)
                status = _format_status(snapshot)
            else:
                status = "显示纯色画面"

            if framebuffer:
                device.send_frame(framebuffer)
                frame_count += 1
            print(f"第 {frame_count:4d} 帧 | {status:<60}", end="\r", flush=True)
            time.sleep(interval)
    except KeyboardInterrupt:
        print(f"\n监控已停止，共发送 {frame_count} 帧")
    finally:
        ipc_server.stop()


def execute_remote(command):
    response = send_ipc_command(command)
    if response is None:
        return False
    if response.get("status") != "ok":
        raise RuntimeError(response.get("message", "未知 IPC 错误"))
    return True


def connect_device():
    device = LMDisplay()
    if device.connect():
        return device
    raise RuntimeError(
        "无法连接 Deepcool LM 设备；请确认 lsusb 可见 3633:0026 且当前用户有 USB 权限"
    )


def main():
    parser = argparse.ArgumentParser(description="Deepcool LM 系列 LCD Linux 驱动")
    commands = parser.add_subparsers(dest="command", required=True)

    monitor_parser = commands.add_parser("monitor", help="显示实时系统监控")
    monitor_parser.add_argument(
        "--interval", type=_positive_interval, default=2.0, help="刷新间隔，默认 2 秒"
    )

    solid_parser = commands.add_parser("solid", help="显示纯色画面")
    solid_parser.add_argument(
        "--color",
        type=_color_channel,
        nargs=3,
        metavar=("R", "G", "B"),
        default=(0, 0, 0),
        help="RGB 颜色，每项范围 0-255",
    )

    brightness_parser = commands.add_parser("brightness", help="调节亮度")
    brightness_parser.add_argument("direction", choices=("up", "down"))

    theme_parser = commands.add_parser("theme", help="动态切换监控画面主题")
    theme_parser.add_argument("name", choices=THEME_NAMES)

    args = parser.parse_args()
    try:
        if args.command == "monitor":
            if execute_remote({"action": "monitor"}):
                print("已切换到监控画面")
                return
            device = connect_device()
            try:
                run_monitor(device, args.interval)
            finally:
                device.disconnect()
            return

        if args.command == "solid":
            color = tuple(args.color)
            if execute_remote({"action": "solid", "color": color}):
                print(f"已显示纯色画面: {color}")
                return
            device = connect_device()
            try:
                device.initialize()
                time.sleep(0.5)
                device.send_frame(rgb_to_framebuffer(render_solid_image(color)))
            finally:
                device.disconnect()
            print(f"已显示纯色画面: {color}")
            return

        if args.command == "theme":
            if not execute_remote({"action": "theme", "theme": args.name}):
                raise RuntimeError("监控服务未运行，无法动态切换主题")
            print(f"已切换到 {args.name} 主题")
            return

        action = "brightness_up" if args.direction == "up" else "brightness_down"
        if execute_remote({"action": action}):
            print("亮度已增加" if args.direction == "up" else "亮度已降低")
            return
        device = connect_device()
        try:
            device.brightness_up() if args.direction == "up" else device.brightness_down()
        finally:
            device.disconnect()
        print("亮度已增加" if args.direction == "up" else "亮度已降低")
    except RuntimeError as error:
        parser.exit(1, f"错误: {error}\n")


def _receive_all(connection, limit):
    data = bytearray()
    while True:
        chunk = connection.recv(4096)
        if not chunk:
            return bytes(data)
        data.extend(chunk)
        if len(data) > limit:
            raise ValueError(f"IPC 消息超过 {limit} 字节")


def _load_theme(path):
    try:
        theme = path.read_text(encoding="utf-8").strip()
    except OSError:
        return THEME_LIGHT
    return theme if theme in THEME_NAMES else THEME_LIGHT


def _save_theme(path, theme):
    path.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
    temporary = path.with_name(
        f".{path.name}.{os.getpid()}.{threading.get_ident()}.tmp"
    )
    try:
        with temporary.open("w", encoding="utf-8") as output:
            output.write(f"{theme}\n")
            output.flush()
            os.fsync(output.fileno())
        os.chmod(temporary, 0o644)
        os.replace(temporary, path)
    finally:
        try:
            temporary.unlink()
        except FileNotFoundError:
            pass


def _validate_color(color):
    if not isinstance(color, (list, tuple)) or len(color) != 3:
        raise ValueError("颜色必须包含三个 RGB 数值")
    if any(type(channel) is not int or not 0 <= channel <= 255 for channel in color):
        raise ValueError("RGB 数值范围必须为 0-255")
    return tuple(color)


def _color_channel(value):
    try:
        channel = int(value)
    except ValueError as error:
        raise argparse.ArgumentTypeError("RGB 必须是整数") from error
    if not 0 <= channel <= 255:
        raise argparse.ArgumentTypeError("RGB 数值范围必须为 0-255")
    return channel


def _positive_interval(value):
    try:
        interval = float(value)
    except ValueError as error:
        raise argparse.ArgumentTypeError("刷新间隔必须是数字") from error
    if interval <= 0:
        raise argparse.ArgumentTypeError("刷新间隔必须大于 0")
    return interval


def _format_status(snapshot):
    cpu_temp = "N/A" if snapshot.cpu_temp is None else f"{snapshot.cpu_temp:.1f}°C"
    cpu_usage = (
        "N/A" if snapshot.cpu_percent is None else f"{snapshot.cpu_percent:.1f}%"
    )
    gpu_temp = "N/A" if snapshot.gpu_temp is None else f"{snapshot.gpu_temp:.1f}°C"
    frequency = "N/A" if snapshot.cpu_freq is None else f"{snapshot.cpu_freq:.2f}GHz"
    return f"CPU {cpu_temp} ({cpu_usage}) | GPU {gpu_temp} | {frequency}"


if __name__ == "__main__":
    main()
