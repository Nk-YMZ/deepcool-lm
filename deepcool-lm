def get_cpu_model():
    """获取 CPU 型号和品牌"""
    try:
        with open('/proc/cpuinfo', 'r') as f:
            content = f.read()
            
        match = re.search(r'model name\s*:\s*(.+)', content)
        if match:
            full_name = match.group(1).strip()
            
            if 'AMD' in full_name:
                # AMD Ryzen 7 7800X3D 16-Core Processor -> Ryzen 7 7800X3D
                # 去掉 AMD 前缀，去掉后面多余
                short = re.sub(r'^AMD\s+', '', full_name)  # 只去掉开头的 AMD
                short = re.sub(r'\s+\d+-Core.*$', '', short)  # 去掉 "16-Core Processor"
                short = re.sub(r'\s+Processor.*$', '', short)  # 去掉 "Processor"
                # 限制长度但保证词完整
                if len(short) > 15:
                    short = short[:15].rsplit(' ', 1)[0]
                return 'AMD', short
                
            elif 'Intel' in full_name:
                # Intel(R) Core(TM) i7-14700K -> Core i7-14700K
                # Intel(R) Xeon(R) E5-2680 -> Xeon E5-2680
                short = re.sub(r'Intel\(R\)\s+', '', full_name)
                short = re.sub(r'Core\(TM\)\s+', 'Core ', short)
                short = re.sub(r'Xeon\(R\)\s+', 'Xeon ', short)
                short = re.sub(r'Pentium\(R\)\s+', 'Pentium ', short)
                short = re.sub(r'Celeron\(R\)\s+', 'Celeron ', short)
                short = re.sub(r'\s+CPU.*$', '', short)  # 去掉 "CPU @ 3.50GHz"
                short = re.sub(r'\s+@.*$', '', short)    # 去掉 "@ 3.50GHz"
                if len(short) > 15:
                    short = short[:15].rsplit(' ', 1)[0]
                return 'Intel', short
            else:
                short = full_name[:15]
                return 'Unknown', short
    except Exception as e:
        print(f"CPU detection error: {e}")
    return 'Unknown', 'Unknown'

