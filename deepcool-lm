    # 获取型号信息（带缓存）
    cpu_brand, cpu_model, cpu_brand_color = get_cached_cpu_info()
    gpu_info = get_cached_gpu_info()

    # === CPU SECTION (Top Half) ===
    cpu_color = get_temp_color(info['cpu_temp'])
    usage_color = get_usage_color(info['cpu_percent'])
    freq_color = get_freq_color(info['cpu_freq'])

    # CPU rounded border box
    draw_rounded_rect(draw, [12, 10, 308, 125], radius=8, outline=(40, 40, 50), width=2)

    # CPU Label (BOLD) with icon and temperature

    # 尝试用 normal_bold，如果太长改用 normal
    icon_text = "⚙ "
    model_text = cpu_model
    
    # 先尝试用 medium 字号（小一点）
    test_bbox = draw.textbbox((0, 0), icon_text + model_text, font=fonts['normal'])
    test_w = test_bbox[2] - test_bbox[0]
    
    # 如果总宽度超过 200，缩短型号
    max_width = 200
    if test_w > max_width:
        # 尝试缩短：Ryzen 7 7800X3D -> Ryzen 7800X3D 或 R7 7800X3D
        short_model = model_text.replace("Ryzen ", "R").replace("Core ", "").replace("Xeon ", "")
        test_bbox = draw.textbbox((0, 0), icon_text + short_model, font=fonts['normal'])
        test_w = test_bbox[2] - test_bbox[0]
        
        if test_w > max_width:
            # 还是太长，直接截断
            while test_w > max_width and len(short_model) > 3:
                short_model = short_model[:-1]
                test_bbox = draw.textbbox((0, 0), icon_text + short_model + "...", font=fonts['normal'])
                test_w = test_bbox[2] - test_bbox[0]
            model_text = short_model + "..."
        else:
            model_text = short_model
    
    # 使用 normal 字体（比 normal_bold 小）
    draw.text((20, 22), icon_text + model_text, fill=cpu_brand_color, font=fonts['normal'])

    cpu_temp_text = f"{info['cpu_temp']:.0f}°"
    bbox = draw.textbbox((0, 0), cpu_temp_text, font=fonts['medium'])
    text_w = bbox[2] - bbox[0]
    draw.text((WIDTH - 20 - text_w, 20), cpu_temp_text, fill=cpu_color, font=fonts['medium'])

    # CPU Usage details
    # usage_detail = f"Usage: {info['cpu_percent']:.0f}% • {info['cpu_freq']:.2f} GHz"
    # draw.text((20, 68), usage_detail, fill=(130, 130, 150), font=fonts['small'])

    # CPU 使用率详情 - 分颜色显示
    # "Usage:" 标签用默认色，数值用 usage_color
    # draw.text((20, 68), "Usage: ", fill=(130, 130, 150), font=fonts['small'])
    usage_label_text = "Usage: "
    draw.text((20, 68), usage_label_text, fill=tuple(max(0, c - 30) for c in cpu_brand_color), font=fonts['small'])

    usage_label_bbox = draw.textbbox((0, 0), "Usage:", font=fonts['small'])
    usage_label_w = usage_label_bbox[2] - usage_label_bbox[0]
    
    usage_text = f"{info['cpu_percent']:.0f}%"
    # bbox = draw.textbbox((0, 0), usage_text, font=fonts['small'])
    # usage_w = bbox[2] - bbox[0]
    draw.text((20 + usage_label_w + 2, 68), usage_text, fill=usage_color, font=fonts['small'])

    usage_bbox = draw.textbbox((0, 0), usage_text, font=fonts['small'])
    usage_w = usage_bbox[2] - usage_bbox[0]
    
    # "•" 分隔符用默认色
    separator_x = 20 + usage_label_w + 2 + usage_w + 4
    draw.text((separator_x, 68), "•", fill=(130, 130, 150), font=fonts['small'])

    # 计算分隔符宽度
    sep_bbox = draw.textbbox((0, 0), "•", font=fonts['small'])
    sep_w = sep_bbox[2] - sep_bbox[0]
    
    # 频率值用 freq_color
    freq_text = f"{info['cpu_freq']:.2f} GHz"
    draw.text((separator_x + sep_w + 4, 68), freq_text, fill=freq_color, font=fonts['small'])

    # CPU Progress bar - full width with rounded corners
    bar_x, bar_y, bar_w, bar_h = 23, 93, WIDTH - 46, 18
    bar_radius = bar_h // 2  # Fully rounded (half the height)
    draw_rounded_rect(draw, [bar_x, bar_y, bar_x + bar_w, bar_y + bar_h],
                      radius=bar_radius, fill=(30, 30, 38), outline=None)
    temp_ratio = min(info['cpu_temp'], 100.0) / 100.0
    fill_w = int(bar_w * temp_ratio)
    if fill_w >= bar_radius * 2:  # Only draw if wide enough for rounded corners
        # bar_color = (100, 180, 255) if info['cpu_percent'] < 75 else (255, 150, 50)
        # draw_rounded_rect(draw, [bar_x, bar_y, bar_x + fill_w, bar_y + bar_h],
        #                   radius=bar_radius, fill=bar_color, outline=None)
        draw_rounded_rect(draw, [bar_x, bar_y, bar_x + fill_w, bar_y + bar_h],
                            radius=bar_radius, fill=cpu_color, outline=None)
        
    # === GPU SECTION (Bottom Half) ===
    gpu_color = get_temp_color(info['gpu_temp'])

    # GPU rounded border box
    draw_rounded_rect(draw, [12, 135, 308, 230], radius=8, outline=(40, 40, 50), width=2)

    # GPU Label (BOLD) with icon and temperature
    gpu_temp = info['gpu_temp']
    gpu_temp_text = f"{gpu_temp:.0f}°" if gpu_temp is not None else "N/A"
    gpu_temp_bbox = draw.textbbox((0, 0), gpu_temp_text, font=fonts['medium'])
    gpu_temp_w = gpu_temp_bbox[2] - gpu_temp_bbox[0]
    gpu_temp_x = WIDTH - 20 - gpu_temp_w
    gpu_temp_y = 145
    max_gpu_model_width = gpu_temp_x - 20 - 10
    # 简化的后缀处理逻辑
    gpu_model_text = gpu_info['model'] if gpu_info['model'] != 'Unknown' else "GPU"
    gpu_brand_color = get_brand_color(gpu_info['brand'])

    # 尝试识别后缀（Ti, Super, XTX等），但保留完整名称
    original_model = gpu_model_text
    suffix = ""

    # 检查是否有后缀
    for suffix_candidate in ['Ti', 'Super', 'XTX', 'XT', 'GRE']:
        if suffix_candidate in original_model:
            # 找到后缀的位置
            suffix_pos = original_model.find(suffix_candidate)
            # 分离基础型号和后缀
            base_model = original_model[:suffix_pos].strip()
            suffix = original_model[suffix_pos:].strip()
            break
    else:
        # 没有找到特殊后缀，使用完整模型名作为基础型号
        base_model = original_model

    # 检查基础型号宽度...
    gpu_icon_text = "▣ "
    test_bbox = draw.textbbox((0, 0), gpu_icon_text + base_model, font=fonts['normal'])
    test_w = test_bbox[2] - test_bbox[0]

    if test_w > max_gpu_model_width:
        # 截断基础型号
        while len(base_model) > 3:
            base_model = base_model[:-1]
            test_text = gpu_icon_text + base_model + "..."
            test_bbox = draw.textbbox((0, 0), test_text, font=fonts['normal'])
            if test_bbox[2] - test_bbox[0] <= max_gpu_model_width:
                base_model = base_model + "..."
                break
    
    # 绘制 GPU 图标和基础型号
    icon_x = 20
    icon_y = 145
    draw.text((20, 145), gpu_icon_text, fill=gpu_brand_color, font=fonts['normal'])
    
    icon_bbox = draw.textbbox((0, 0), gpu_icon_text, font=fonts['normal'])
    icon_w = icon_bbox[2] - icon_bbox[0]
    base_x = icon_x + icon_w
    base_y = icon_y
    draw.text((20 + icon_w, 145), base_model, fill=gpu_brand_color, font=fonts['normal'])
    
    # 绘制后缀（小字）- 放在右下角
    if suffix:
        # 计算基础型号的实际宽度
        base_bbox = draw.textbbox((0, 0), base_model, font=fonts['normal'])
        base_w = base_bbox[2] - base_bbox[0]
        
        # 后缀放在基础型号的右侧
        suffix_x = base_x + base_w + 2  # 基础型号右侧，留2px间隙
        suffix_y = base_y + 6  # 稍微向下偏移，与基础型号对齐
        
        # 检查后缀是否会超出温度文本的左边界
        suffix_bbox = draw.textbbox((0, 0), suffix, font=fonts['small'])
        suffix_w = suffix_bbox[2] - suffix_bbox[0]
        
        if suffix_x + suffix_w < gpu_temp_x - 5:  # 确保不覆盖温度
            suffix_color = tuple(max(0, c - 50) for c in gpu_brand_color)
            draw.text((suffix_x, suffix_y), suffix, fill=suffix_color, font=fonts['small'])
        else:
            # 如果空间不够，尝试换行显示
            suffix_y_new = base_y + 26  # 换到下一行
            if suffix_y_new < 175:  # 确保不超出GPU区域
                draw.text((base_x, suffix_y_new), suffix, fill=gpu_brand_color, font=fonts['small'])

    gpu_temp_text = f"{info['gpu_temp']:.0f}°"
    bbox = draw.textbbox((0, 0), gpu_temp_text, font=fonts['medium'])
    text_w = bbox[2] - bbox[0]
    draw.text((WIDTH - 20 - text_w, 145), gpu_temp_text, fill=gpu_color, font=fonts['medium'])

    # GPU Temp Progress bar - full width with rounded corners
    bar_x, bar_y, bar_w, bar_h = 23, 200, WIDTH - 46, 18
    bar_radius = bar_h // 2  # Fully rounded (half the height)
    draw_rounded_rect(draw, [bar_x, bar_y, bar_x + bar_w, bar_y + bar_h],
                      radius=bar_radius, fill=(30, 30, 38), outline=None)
    fill_w = int(bar_w * min(info['gpu_temp'] / 100.0, 1.0))
    if fill_w >= bar_radius * 2:  # Only draw if wide enough for rounded corners
        draw_rounded_rect(draw, [bar_x, bar_y, bar_x + fill_w, bar_y + bar_h],
                          radius=bar_radius, fill=gpu_color, outline=None)

    return rgb_to_framebuffer(img)

