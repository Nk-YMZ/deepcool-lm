def get_system_info():
    """Get all system information"""
    info = {
        'cpu_temp': 0.0,
        'gpu_temp': 0.0,
        'cpu_percent': 0.0,
        'cpu_freq': 0.0,
    }

    # CPU temperature
    try:
        temps = psutil.sensors_temperatures()
        # if 'coretemp' in temps and len(temps['coretemp']) > 0:
        #     info['cpu_temp'] = round(temps['coretemp'][0].current, 1)
        # 优先找 AMD 的 k10temp
        if 'k10temp' in temps:
            # 遍历所有传感器，寻找 Tctl 或 Tdie
            found = False
            for sensor in temps['k10temp']:
                if sensor.label in ['Tctl', 'Tdie']:
                    info['cpu_temp'] = round(sensor.current, 1)
                    found = True
                    break
            # 如果没找到标签，才退而求其次用第一个
            if not found and len(temps['k10temp']) > 0:
                info['cpu_temp'] = round(temps['k10temp'][0].current, 1)

        # 如果是 Intel 或其他情况 (备用)
        elif 'coretemp' in temps:
             if len(temps['coretemp']) > 0:
                info['cpu_temp'] = round(temps['coretemp'][0].current, 1)

        # if 'nvme' in temps and len(temps['nvme']) > 0:
        #     info['gpu_temp'] = round(temps['nvme'][0].current, 1)
        if 'amdgpu' in temps and len(temps['amdgpu']) > 0:
             info['gpu_temp'] = round(temps['amdgpu'][0].current, 1)
        if info['gpu_temp'] == 0.0:
            try:
                import subprocess
                result = subprocess.run(
                    ['nvidia-smi', '--query-gpu=temperature.gpu', '--format=csv,noheader,nounits'],
                    capture_output=True, text=True, timeout=2
                )
                if result.returncode == 0:
                    temp_str = result.stdout.strip()
                    if temp_str:
                        info['gpu_temp'] = float(temp_str)
            except (FileNotFoundError, subprocess.TimeoutExpired, ValueError):
                pass  # nvidia-smi 不可用或执行失败
    except:
        pass

    # CPU usage and frequency
    try:
        info['cpu_percent'] = round(psutil.cpu_percent(interval=0.1), 1)
        freq = psutil.cpu_freq()
        if freq:
            info['cpu_freq'] = round(freq.current / 1000, 2)
    except:
        pass

    return info

def rgb_to_framebuffer(img):
    """Convert PIL RGB image to RGB565 framebuffer"""
    if img.mode != 'RGB':
        img = img.convert('RGB')
    if img.size != (WIDTH, HEIGHT):
        img = img.resize((WIDTH, HEIGHT), Image.Resampling.LANCZOS)

    framebuffer = bytearray()
    pixels = img.load()

    for y in range(HEIGHT):
        for x in range(WIDTH):
            r, g, b = pixels[x, y]
            # Convert to RGB565
            r5 = (r >> 3) & 0x1F
            g6 = (g >> 2) & 0x3F
            b5 = (b >> 3) & 0x1F
            rgb565 = (r5 << 11) | (g6 << 5) | b5
            # Append as little-endian
            framebuffer.append(rgb565 & 0xFF)
            framebuffer.append((rgb565 >> 8) & 0xFF)

    return bytes(framebuffer)

