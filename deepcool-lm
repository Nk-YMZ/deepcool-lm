def parse_gpu_model(model):
    """
    解析 GPU 型号，分离基础型号和后缀
    例如: "RTX 4070 Ti Super" -> ("RTX 4070", "Ti Super")
          "RX 7900 XTX" -> ("RX 7900", "XTX")
    """
    model = model.strip()
    
    # 先标准化：确保 Ti/Super/XTX 前有空格
    model = re.sub(r'(\d)(Ti|Super|XTX|XT|GRE)', r'\1 \2', model)
    model = re.sub(r'(Ti)(Super)', r'\1 \2', model)
    
    # 匹配基础型号：前缀 + 数字（必须结束或跟空格）
    match = re.match(r'^((?:RTX|RX|GTX|R\d+|Pro)?\s*\d{3,4})\b(.*)', model)
    
    if match:
        base = match.group(1).strip()
        suffix = match.group(2).strip()
        
        # 如果基础型号还包含 Ti（不应该），分离出来
        if 'Ti' in base and 'Ti' in suffix:
            base = base.replace('Ti', '').strip()
        
        return base, suffix
    
    return model, ""

